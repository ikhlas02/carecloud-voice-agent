# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/patients.db

# Vapi Configuration (get from https://dashboard.vapi.ai)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_phone_number_id_here
VAPI_ASSISTANT_ID=your_assistant_id_here

# Server URL (used for Vapi webhook configuration)
# In development, use ngrok URL; in production, use your deployed URL
SERVER_URL=https://your-server-url.railway.app
